    async function fetchUserOrders() {
      const list = document.getElementById('userOrdersList');
      list.innerHTML = '<p class="text-xs text-gray-400">Loading orders...</p>';
      try {
        const res = await authFetch('/api/orders');
        const data = await res.json();
        if (data.success && data.orders && data.orders.length > 0) {
          list.innerHTML = data.orders.map(o => `
            <div class="p-3 bg-white rounded-xl border border-gray-200 text-xs shadow-sm">
              <div class="flex justify-between font-bold text-gray-900 mb-1">
                <span class="font-mono">${escapeHtml(o.order_number)}</span>
                <span class="text-[#C5A059]">${Number(o.total_tzs).toLocaleString()} TZS</span>
              </div>
              <p class="text-gray-500">For ${escapeHtml(o.recipient_name)} (${escapeHtml(o.city || 'Dar es Salaam')})</p>
              <div class="flex justify-between items-center text-[10px] text-gray-400 mt-2 pt-2 border-t border-gray-100">
                <span class="uppercase font-semibold">${escapeHtml(o.payment_method || 'mpesa')}</span>
                <span class="px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold">${escapeHtml(o.status || 'confirmed')}</span>
              </div>
            </div>
          `).join('');
        } else {
          list.innerHTML = '<p class="text-xs text-gray-400 py-3 text-center">No previous orders placed yet.</p>';
        }
      } catch (e) {
        list.innerHTML = '<p class="text-xs text-rose-500">Unable to load order history.</p>';
      }
    }

    // PERSISTENT CART SYNCHRONIZATION
    async function syncCartWithServer() {
      if (!currentUser) return;
      try {
        const res = await authFetch('/api/cart');
        const data = await res.json();
        if (data.success && Array.isArray(data.items)) {
          if (data.items.length > 0 && cart.length === 0) {
            cart = data.items;
            localStorage.setItem('frembogifts_cart', JSON.stringify(cart));
            updateCartUI();
          } else if (cart.length > 0) {
            // Push local cart to server
            await authFetch('/api/cart', {
              method: 'POST',
              body: JSON.stringify({ items: cart })
            });
          }
        }
      } catch (e) {
        console.warn('Cart sync notice:', e);
      }
    }

    function loadCartFromStorage() {
      try {
        const stored = localStorage.getItem('frembogifts_cart');
        if (stored) cart = JSON.parse(stored);
      } catch (e) {
        cart = [];
      }
      updateCartUI();
    }

    function saveCartToStorage() {
      try {
        localStorage.setItem('frembogifts_cart', JSON.stringify(cart));
      } catch (e) {}
      updateCartUI();
      // Auto sync to server if authenticated
      if (currentUser) {
        authFetch('/api/cart', {
          method: 'POST',
          body: JSON.stringify({ items: cart })
        }).catch(() => {});
      }
    }

    function addToCart(productId) {
      const prod = rawProducts.find(p => p.id === productId);
      if (!prod) return;

      const existing = cart.find(item => item.id === productId);
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({
          id: prod.id,
          name: prod.name,
          price_tzs: prod.price_tzs,
          price_usd: prod.price_usd || Math.round(prod.price_tzs / 2500),
          tier: prod.tier,
          image_url: prod.image_url,
          quantity: 1
        });
      }

      saveCartToStorage();
      toggleCartDrawer(true);
      showToast(`Added "${prod.name}" to cart`);
    }

    function updateCartItemQty(id, delta) {
      const item = cart.find(x => x.id === id);
      if (!item) return;
      item.quantity += delta;
      if (item.quantity <= 0) {
        cart = cart.filter(x => x.id !== id);
      }
      saveCartToStorage();
    }

    function removeCartItem(id) {
      cart = cart.filter(x => x.id !== id);
      saveCartToStorage();
    }

    function updateCartUI() {
      const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
      document.getElementById('cartCountBadge').textContent = totalItems;

      const container = document.getElementById('cartItemsContainer');
      const checkoutBtn = document.getElementById('checkoutBtn');

      if (cart.length === 0) {
        container.innerHTML = `
          <div class="text-center py-16">
            <div class="w-12 h-12 bg-gray-100 text-gray-400 rounded-full flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            </div>
            <p class="text-gray-500 font-medium text-sm">Your gift cart is empty</p>
            <p class="text-xs text-gray-400 mt-1">Select a bouquet, coffee, or gift hamper to add it.</p>
          </div>
        `;
        if (checkoutBtn) checkoutBtn.disabled = true;
        document.getElementById('cartSubtotal').textContent = '0 TZS';
        document.getElementById('cartTotalTZS').textContent = '0 TZS';
        document.getElementById('cartTotalUSD').textContent = '(about $0 USD)';
        document.getElementById('cartDiscountRow').classList.add('hidden');
        return;
      }

      if (checkoutBtn) checkoutBtn.disabled = false;

      let subtotal = 0;
      container.innerHTML = cart.map(item => {
        const itemTotal = item.price_tzs * item.quantity;
        subtotal += itemTotal;

        return `
          <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-xl border border-gray-100">
            <img src="${escapeHtml(item.image_url || '/assets/images/giftopia-placeholder.svg')}" class="w-14 h-14 object-cover rounded-lg bg-gray-200 flex-shrink-0" alt="${escapeHtml(item.name)}" onerror="this.onerror=null;this.src='/assets/images/giftopia-placeholder.svg'">
            <div class="flex-1 min-w-0">
              <h4 class="font-bold text-xs text-gray-900 truncate">${escapeHtml(item.name)}</h4>
              <p class="text-xs font-semibold text-[#C5A059] mt-0.5">${Number(item.price_tzs).toLocaleString()} TZS</p>
              <div class="flex items-center gap-2 mt-2">
                <button onclick="updateCartItemQty(${item.id}, -1)" class="w-5 h-5 bg-white border border-gray-200 rounded flex items-center justify-center text-xs font-bold hover:bg-gray-100">-</button>
                <span class="text-xs font-bold text-gray-800">${item.quantity}</span>
                <button onclick="updateCartItemQty(${item.id}, 1)" class="w-5 h-5 bg-white border border-gray-200 rounded flex items-center justify-center text-xs font-bold hover:bg-gray-100">+</button>
              </div>
            </div>
            <button onclick="removeCartItem(${item.id})" class="text-gray-400 hover:text-rose-500 p-1" title="Remove item">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        `;
      }).join('');

      let discountAmount = 0;
      if (activeOffers.length > 0) {
        const topOffer = activeOffers[0];
        discountAmount = Math.round((subtotal * topOffer.discount_percent) / 100);
        document.getElementById('cartDiscountAmount').textContent = `-${discountAmount.toLocaleString()} TZS (${topOffer.discount_percent}%)`;
        document.getElementById('cartDiscountRow').classList.remove('hidden');
      } else {
        document.getElementById('cartDiscountRow').classList.add('hidden');
      }

      const finalTotalTZS = Math.max(0, subtotal - discountAmount);
      const finalTotalUSD = Math.round(finalTotalTZS / 2500);

      document.getElementById('cartSubtotal').textContent = `${subtotal.toLocaleString()} TZS`;
      document.getElementById('cartTotalTZS').textContent = `${finalTotalTZS.toLocaleString()} TZS`;
      document.getElementById('cartTotalUSD').textContent = `(about $${finalTotalUSD} USD)`;
      document.getElementById('checkoutTotalBtn').textContent = `${finalTotalTZS.toLocaleString()} TZS`;
    }

    function toggleCartDrawer(open) {
      const drawer = document.getElementById('cartDrawer');
      if (open) {
        drawer.classList.remove('hidden');
      } else {
        drawer.classList.add('hidden');
      }
    }

    function toggleMobileMenu() {
      const menu = document.getElementById('mobileMenu');
      menu.classList.toggle('hidden');
    }

    // CHECKOUT PRE-FILLED WITH SAVED DETAILS
    function openCheckoutModal() {
      if (cart.length === 0) return;
      toggleCartDrawer(false);

      const notice = document.getElementById('checkoutUserStatusNotice');
      const badge = document.getElementById('orderSavedPaymentBadge');

      if (currentUser) {
        notice.textContent = `Ordering as ${currentUser.name} (${currentUser.email})`;
        document.getElementById('orderRecipient').value = currentUser.name || '';
        document.getElementById('orderPhone').value = currentUser.phone || currentUser.mpesa_number || '';
        document.getElementById('orderCity').value = currentUser.city || 'Dar es Salaam';

        // Pre-fill payment method
        if (currentUser.payment_method === 'card') {
          document.querySelector('input[name="orderPaymentMethod"][value="card"]').checked = true;
          badge.textContent = `✓ Saved card preference ending in •••• ${currentUser.card_last4 || '—'}`;
        } else {
          document.querySelector('input[name="orderPaymentMethod"][value="mpesa"]').checked = true;
          badge.textContent = `✓ Saved M-Pesa preference (${currentUser.mpesa_number || currentUser.phone || 'number on file'})`;
        }
        badge.classList.remove('hidden');
      } else {
        notice.innerHTML = `<a href="javascript:openAuthModal('login')" class="text-[#C5A059] font-semibold underline">Sign in</a> to use saved payment details`;
        badge.classList.add('hidden');
      }

      document.getElementById('checkoutModal').classList.remove('hidden');
    }

    function closeCheckoutModal() {
      document.getElementById('checkoutModal').classList.add('hidden');
    }

    async function completeOrder(e) {
      e.preventDefault();
      const recipient_name = document.getElementById('orderRecipient').value.trim();
      const phone = document.getElementById('orderPhone').value.trim();
      const city = document.getElementById('orderCity').value;
      const neighborhood = (document.getElementById('orderNeighborhood') || {value:''}).value.trim();
      const landmark = (document.getElementById('orderLandmark') || {value:''}).value.trim();
      const is_surprise = (document.getElementById('orderIsSurprise') || {checked:false}).checked;
      const gift_message = document.getElementById('orderNote').value.trim();
      const payment_method = document.querySelector('input[name="orderPaymentMethod"]:checked').value;

      let subtotal = cart.reduce((sum, item) => sum + (item.price_tzs * item.quantity), 0);
      let discount_tzs = 0;
      if (activeOffers.length > 0) {
        discount_tzs = Math.round((subtotal * activeOffers[0].discount_percent) / 100);
      }
      const total_tzs = Math.max(0, subtotal - discount_tzs);
      const total_usd = Math.round(total_tzs / 2500);

      const orderPayload = {
        recipient_name,
        phone,
        city,
        neighborhood,
        landmark,
        is_surprise,
        gift_message,
        items: cart,
        total_tzs,
        total_usd,
        discount_tzs,
        payment_method
      };

      try {
        const res = await authFetch('/api/orders', {
          method: 'POST',
          body: JSON.stringify(orderPayload)
        });
        const data = await res.json();
        if (data.success && data.order) {
          document.getElementById('confirmedOrderId').textContent = `#${data.order.order_number}`;
          document.getElementById('confirmedRecipient').textContent = recipient_name;
          document.getElementById('confirmedCity').textContent = city;

          // Clear cart
          cart = [];
          saveCartToStorage();

          closeCheckoutModal();
          document.getElementById('orderSuccessModal').classList.remove('hidden');
        } else {
          showToast(data.message || 'Error completing order', 'error');
        }
      } catch (err) {
        showToast('Error: ' + err.message, 'error');
      }
    }

    function closeSuccessModal() {
      document.getElementById('orderSuccessModal').classList.add('hidden');
    }

    const occasionLabels = {
      birthday: 'Birthday gifts',
      celebration: 'Celebration gifts',
      gratitude: 'Thank-you gifts',
      love: 'Love and anniversary gifts',
      souvenir: 'Tanzanian keepsakes'
    };

    function updateGridHeading() {
      const tierLabel = currentTier === 'budget' ? 'Budget' : currentTier === 'premium' ? 'Premium' : '';
      const occasionLabel = occasionLabels[currentOccasion] || '';
      const heading = [tierLabel, occasionLabel].filter(Boolean).join(' · ');
      document.getElementById('gridTitle').textContent = heading || 'All Gifts';
      document.getElementById('gridSubtitle').textContent = heading
        ? `Thoughtfully selected ${heading.toLowerCase()} from Tanzania.`
        : 'Find a gift for a Tanzanian celebration, thank-you, or a keepsake from your travels.';
    }

    function setTierFilter(tier) {
      currentTier = tier;
      document.querySelectorAll('.collection-filter').forEach(button => {
        button.setAttribute('aria-pressed', String(button.dataset.tier === tier));
      });
      updateGridHeading();
      renderGrid();
    }

    function setOccasionFilter(occasion) {
      currentOccasion = occasion;
      document.querySelectorAll('.occasion-filter').forEach(button => {
        button.setAttribute('aria-pressed', String(button.dataset.occasion === occasion));
      });
      updateGridHeading();
      renderGrid();
    }

    function handleSearch(e) {
      searchQuery = e.target.value.toLowerCase().trim();
      if (e.target.id === 'searchInput') {
        const m = document.getElementById('mobileSearchInput');
        if (m) m.value = e.target.value;
      } else {
        const s = document.getElementById('searchInput');
        if (s) s.value = e.target.value;
      }
      renderGrid();
    }

    function handleSortChange() {
      currentSort = document.getElementById('sortSelect').value;
      renderGrid();
    }

    function clearAllFilters() {
      searchQuery = '';
      currentSort = 'featured';
      document.getElementById('searchInput').value = '';
      const m = document.getElementById('mobileSearchInput');
      if (m) m.value = '';
      document.getElementById('sortSelect').value = 'featured';
      setOccasionFilter('all');
      setTierFilter('all');
    }

    function renderGrid() {
      const grid = document.getElementById('productsGrid');
      const empty = document.getElementById('emptyState');
      const countLabel = document.getElementById('filterResultCount');

      let filtered = rawProducts.filter(p => {
        const matchesTier = currentTier === 'all' || p.tier === currentTier;
        const matchesOccasion = currentOccasion === 'all' || p.occasions.includes(currentOccasion);
        const matchesSearch = !searchQuery ||
          p.name.toLowerCase().includes(searchQuery) ||
          (p.description && p.description.toLowerCase().includes(searchQuery));
        return matchesTier && matchesOccasion && matchesSearch;
      });

      if (currentSort === 'price-asc') {
        filtered.sort((a, b) => a.price_tzs - b.price_tzs);
      } else if (currentSort === 'price-desc') {
        filtered.sort((a, b) => b.price_tzs - a.price_tzs);
      } else if (currentSort === 'name-asc') {
        filtered.sort((a, b) => a.name.localeCompare(b.name));
      }

      countLabel.textContent = `${filtered.length} ${filtered.length === 1 ? 'gift' : 'gifts'} available`;

      if (filtered.length === 0) {
        grid.innerHTML = '';
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');
      grid.innerHTML = filtered.map(p => `
        <article class="product-card bg-white rounded-2xl overflow-hidden border border-gray-200/80 shadow-sm min-w-0">
          <div class="relative overflow-hidden">
            <img src="${escapeHtml(p.image_url || '/assets/images/giftopia-placeholder.svg')}" alt="${escapeHtml(p.name)}" class="product-image transition-transform duration-500 hover:scale-105" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/assets/images/giftopia-placeholder.svg'">
            <span class="absolute top-3 left-3 text-[11px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider ${p.tier === 'budget' ? 'bg-amber-100 text-amber-900 border border-amber-200' : 'bg-purple-100 text-purple-900 border border-purple-200'}">
              ${p.tier === 'budget' ? 'Budget Tier' : 'Premium Tier'}
            </span>
          </div>
          <div class="product-card__details p-5">
            <h3 class="font-display font-bold text-gray-900 text-lg leading-snug line-clamp-2">${escapeHtml(p.name)}</h3>
            <p class="text-xs text-gray-500 mt-2 line-clamp-3 leading-relaxed">${escapeHtml(p.description || 'Handcrafted authentic gift collection.')}</p>
            <div class="flex items-baseline justify-between mb-4">
              <span class="text-lg font-extrabold text-[#C5A059]">${Number(p.price_tzs).toLocaleString()} TZS</span>
              <span class="text-xs text-gray-400 font-medium">≈ $${p.price_usd || Math.round(p.price_tzs / 2500)} USD</span>
            </div>
            <div class="product-card__actions space-y-2">
              <button type="button" onclick="addToCart(${Number(p.id)})" aria-label="Add ${escapeHtml(p.name)} to cart" class="w-full py-3 bg-[#0E1726] text-white rounded-xl text-sm font-bold hover:bg-[#16213E] active:scale-95 transition flex items-center justify-center gap-2 shadow-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v12m-6-6h12"/></svg>
                <span>Add to Cart</span>
              </button>
              ${whatsappNumber ? `<a href="${escapeHtml(productWhatsAppUrl(p))}" target="_blank" rel="noopener noreferrer" class="block w-full py-2 text-center text-sm font-semibold text-emerald-800 hover:text-emerald-900">Ask about this gift on WhatsApp</a>` : ''}
            </div>
          </div>
        </article>
      `).join('');
    }

    function productWhatsAppUrl(product) {
      const message = `Habari Giftopia! Ningependa kuuliza kuhusu ${product.name} (${Number(product.price_tzs).toLocaleString()} TZS).`;
      return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
</body>
</html>
