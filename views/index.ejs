<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tanzanian Gifts & Souvenirs | Giftopia</title>
  <link rel="stylesheet" href="/assets/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen flex flex-col bg-[#FAF8F5]">

  <!-- Toast Notification Container -->
  <div id="storeToastContainer" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full"></div>

  <!-- Dynamic Active Campaign Announcement Bar -->
  <div id="campaignBanner" class="tanzanite-bg text-white text-xs py-2 px-4 text-center font-semibold">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-[#C5A059] animate-pulse"></span>
      <span id="campaignBannerText"><% if (campaigns.length) { %><%= campaigns[0].title %>: <%= campaigns[0].description || 'Gifts for celebrations at home and keepsakes from Tanzania' %><% } else { %>Gifts for celebrations at home and keepsakes from Tanzania<% } %></span>
    </div>
  </div>

  <!-- Dynamic Promotional Offers Ribbon -->
  <div id="offersRibbon" class="bg-[#FBF6EC] text-[#0E1726] text-xs py-1.5 px-4 text-center font-medium border-b border-[#EBD8B8] <%= offers.length ? '' : 'hidden' %>">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-4 flex-wrap" id="offersList">
      <% offers.forEach((offer, index) => { %>
        <% if (index > 0) { %><span class="text-[#C5A059]">•</span><% } %>
        <span class="inline-flex items-center gap-1.5">
          <span class="font-bold bg-[#C5A059] text-white text-[10px] px-1.5 py-0.5 rounded"><%= offer.discount_percent %>% OFF</span>
          <span><%= offer.title %> - <%= offer.description || '' %></span>
        </span>
      <% }); %>
    </div>
  </div>

  <!-- Navigation Bar -->
  <nav class="bg-white/95 backdrop-blur-md border-b border-[#E8E5DF] sticky top-0 z-40 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">

      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <span class="w-9 h-9 rounded-xl gold-shimmer flex items-center justify-center text-[#0E1726] font-extrabold text-sm shadow-md group-hover:scale-105 transition-transform">FG</span>
        <div>
          <span class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-[#0E1726] leading-none">Giftopia</span>
          <span class="hidden sm:block text-[9px] uppercase tracking-widest text-[#C5A059] font-bold mt-0.5">Dar es Salaam • Gifting Studio</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-7">
        <a href="#storefrontMain" class="text-sm font-semibold text-gray-900 hover:text-[#C5A059] transition">Shop Gifts</a>
        <a href="#occasionFilters" class="text-sm font-medium text-gray-600 hover:text-[#C5A059] transition">Shop by Occasion</a>
        <a href="#about" class="text-sm font-medium text-gray-600 hover:text-[#C5A059] transition">About Tanzania</a>
        <a href="/admin" id="navAdminLink" class="text-xs px-2.5 py-1 rounded-full bg-gray-100 text-gray-700 hover:bg-gray-200 transition font-medium border border-gray-200 hidden">Admin</a>
      </div>

      <!-- Search, Auth & Cart -->
      <div class="flex items-center gap-2 sm:gap-4">

        <!-- Search Trigger / Input -->
        <div class="relative hidden sm:block">
          <input type="text" id="searchInput" oninput="handleSearch(event)" placeholder="Search coffee, shuka..." class="pl-9 pr-4 py-1.5 text-xs border border-gray-200 rounded-full w-44 lg:w-56 focus:outline-none focus:ring-2 focus:ring-[#C5A059] bg-gray-50 focus:bg-white transition">
          <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        </div>

        <!-- AUTH BUTTON: SIGN IN (Logged Out) or USER PROFILE (Logged In) -->
        <div id="authNavContainer">
          <!-- Populated dynamically via JS -->
          <button onclick="openAuthModal('login')" class="whitespace-nowrap text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-300 text-gray-700 hover:bg-gray-50 transition">
            Sign In
          </button>
        </div>

        <!-- Cart Button -->
        <button onclick="toggleCartDrawer(true)" class="relative p-2 text-gray-700 hover:text-[#C5A059] transition" aria-label="Shopping Cart">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          <span id="cartCountBadge" class="absolute top-1 right-1 w-5 h-5 gold-shimmer text-[#0E1726] text-[10px] font-extrabold rounded-full flex items-center justify-center shadow-sm">0</span>
        </button>

        <!-- Mobile Menu Toggle -->
        <button onclick="toggleMobileMenu()" class="md:hidden p-2 text-gray-700 hover:text-[#C5A059]">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Search input bar -->
    <div class="sm:hidden px-4 pb-3">
      <input type="text" id="mobileSearchInput" oninput="handleSearch(event)" placeholder="Search gifts, flowers, shuka..." class="w-full pl-9 pr-4 py-2 text-xs border border-gray-200 rounded-full focus:outline-none focus:ring-2 focus:ring-[#C5A059] bg-gray-50">
    </div>
  </nav>

  <!-- Mobile Slide Menu -->
  <div id="mobileMenu" class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm hidden">
    <div class="fixed right-0 top-0 bottom-0 w-72 bg-white p-6 shadow-xl flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-gray-100">
          <span class="font-display text-xl font-bold text-[#0E1726]">Giftopia</span>
          <button onclick="toggleMobileMenu()" class="text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
        </div>
        <div class="flex flex-col gap-3 mt-6">
          <a href="#storefrontMain" onclick="toggleMobileMenu()" class="font-medium py-2 border-b border-gray-50">Shop Gifts</a>
          <a href="#occasionFilters" onclick="toggleMobileMenu()" class="font-medium py-2 border-b border-gray-50">Shop by Occasion</a>
          <a href="#about" onclick="toggleMobileMenu()" class="font-medium py-2 border-b border-gray-50">About Tanzania</a>
          <button onclick="openAccountDrawer(); toggleMobileMenu()" id="mobileAccountLink" class="text-left font-medium py-2 border-b border-gray-50 hidden text-emerald-700">My Account & Payment Details</button>
          <a href="/admin" class="font-medium py-2 text-[#C5A059] flex items-center justify-between">
            <span>Admin Portal</span>
            <span class="text-xs">&rarr;</span>
          </a>
        </div>
      </div>
      <div class="text-xs text-gray-500 pt-4 border-t border-gray-100">
        &copy; 2026 Giftopia Ltd.
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section id="heroSection" class="relative bg-gradient-to-b from-[#F0EBE0] via-[#FAF8F5] to-[#FAF8F5] px-4 border-b border-[#E8E5DF] overflow-hidden">
    <div class="hero-layout">
      <div class="hero-copy">
        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold bg-[#C5A059] text-white uppercase tracking-wider mb-4 shadow-sm">
          Zawadi za Tanzania · Gifts from Tanzania
        </span>
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight leading-tight">
          Give a little Tanzania.
        </h1>
        <p class="text-gray-600 text-base sm:text-lg mt-4 leading-relaxed">
          For Tanzanians celebrating at home, visitors finding a meaningful keepsake, and families sending gifts to Tanzania. Explore Arusha coffee, Zanzibar spices, Maasai shuka, and flowers.
        </p>
      </div>

      <div class="hero-gallery" role="group" aria-label="A look at Tanzanian gifts and flavors">
        <figure class="hero-gallery__feature">
          <img src="/assets/images/zanzibar-spice.jpg" alt="Colorful spices inspired by Zanzibar" decoding="async">
          <figcaption>Zanzibar spices</figcaption>
        </figure>
        <div class="hero-gallery__stack">
          <figure>
            <img src="/assets/images/thinking-of-you.jpg" alt="Fresh flowers arranged as a gift" decoding="async">
            <figcaption>Flowers for life's moments</figcaption>
          </figure>
          <figure>
            <img src="/assets/images/birthday-hamper.jpg" alt="A wrapped gift ready to share" decoding="async">
            <figcaption>A gift to remember</figcaption>
          </figure>
        </div>
      </div>

      <div class="hero-tier-filters" role="group" aria-label="Filter gifts by price tier">
        <button type="button" onclick="setTierFilter('all')" class="collection-filter" data-tier="all" aria-pressed="true">
          All Collections
        </button>
        <button type="button" onclick="setTierFilter('budget')" class="collection-filter" data-tier="budget" aria-pressed="false">
          Budget Tier (~30K TZS / $12)
        </button>
        <button type="button" onclick="setTierFilter('premium')" class="collection-filter" data-tier="premium" aria-pressed="false">
          Premium Tier (~180K TZS / $72)
        </button>
      </div>
    </div>
  </section>

  <section class="bg-white border-b border-[#E8E5DF]" aria-label="Shopping information">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-3 px-4 py-4 text-center text-xs text-gray-600 sm:grid-cols-4 sm:px-6 lg:px-8">
      <p class="font-semibold">Arusha coffee · Zanzibar spices · Maasai shuka</p>
      <p>Prices shown in TZS; USD is an estimate</p>
      <p>Add a neighborhood; landmarks help with directions</p>
      <p>Optional surprise delivery</p>
    </div>
  </section>

  <!-- Main Dynamic Products Grid -->
  <main id="storefrontMain" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 flex-1 w-full">
    <div id="occasionFilters" class="mb-7 pt-8" aria-labelledby="occasionHeading">
      <h2 id="occasionHeading" class="text-sm font-bold uppercase tracking-wide text-gray-700">Shop by occasion or find a Tanzania keepsake</h2>
      <div class="occasion-filters mt-3 flex gap-2 overflow-x-auto pb-2" role="group" aria-label="Filter gifts by occasion">
        <button type="button" class="occasion-filter" data-occasion="all" aria-pressed="true" onclick="setOccasionFilter('all')">All gifts</button>
        <button type="button" class="occasion-filter" data-occasion="birthday" aria-pressed="false" onclick="setOccasionFilter('birthday')">Siku ya Kuzaliwa · Birthday</button>
        <button type="button" class="occasion-filter" data-occasion="love" aria-pressed="false" onclick="setOccasionFilter('love')">Upendo · Love</button>
        <button type="button" class="occasion-filter" data-occasion="celebration" aria-pressed="false" onclick="setOccasionFilter('celebration')">Sherehe · Celebrations</button>
        <button type="button" class="occasion-filter" data-occasion="gratitude" aria-pressed="false" onclick="setOccasionFilter('gratitude')">Shukrani · Thank you</button>
        <button type="button" class="occasion-filter" data-occasion="souvenir" aria-pressed="false" onclick="setOccasionFilter('souvenir')">Kumbukumbu · Keepsakes</button>
      </div>
    </div>

    <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2 id="gridTitle" class="font-display text-2xl font-bold text-gray-900">All Gifts</h2>
        <p id="gridSubtitle" class="text-sm text-gray-500 mt-1">Find a gift for a Tanzanian celebration, thank-you, or a keepsake from your travels.</p>
        <p id="filterResultCount" class="text-xs text-gray-500 mt-2"><%= products.length %> <%= products.length === 1 ? 'gift' : 'gifts' %> available</p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <label for="sortSelect" class="text-xs font-semibold text-gray-500 uppercase">Sort by:</label>
        <select id="sortSelect" onchange="handleSortChange()" class="text-xs border border-gray-200 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-[#C5A059] bg-[#FAF8F5]">
          <option value="featured">Featured / Default</option>
          <option value="price-asc">Price: Low to High</option>
          <option value="price-desc">Price: High to Low</option>
          <option value="name-asc">Name: A to Z</option>
        </select>
      </div>
    </div>

    <!-- Products Grid Container -->
    <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% products.forEach(product => { %>
        <article class="product-card bg-white rounded-2xl overflow-hidden border border-gray-200/80 shadow-sm min-w-0">
          <div class="relative overflow-hidden">
            <img src="<%= product.image_url || '/assets/images/giftopia-placeholder.svg' %>" alt="<%= product.name %>" class="product-image transition-transform duration-500 hover:scale-105" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/assets/images/giftopia-placeholder.svg'">
            <span class="absolute top-3 left-3 text-[11px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider <%= product.tier === 'budget' ? 'bg-amber-100 text-amber-900 border border-amber-200' : 'bg-purple-100 text-purple-900 border border-purple-200' %>">
              <%= product.tier === 'budget' ? 'Budget Tier' : 'Premium Tier' %>
            </span>
          </div>
          <div class="product-card__details p-5">
            <h3 class="font-display font-bold text-gray-900 text-lg leading-snug line-clamp-2"><%= product.name %></h3>
            <p class="text-xs text-gray-500 mt-2 line-clamp-3 leading-relaxed"><%= product.description || 'Handcrafted authentic gift collection.' %></p>
            <div class="flex items-baseline justify-between mb-4">
              <div>
                <span class="text-lg font-extrabold text-[#C5A059]"><%= Number(product.price_tzs).toLocaleString() %> TZS</span>
                <span class="text-xs text-gray-400 font-medium ml-1">≈ $<%= product.price_usd || Math.round(product.price_tzs / 2500) %> USD</span>
              </div>
            </div>
            <div class="product-card__actions space-y-2">
              <button type="button" onclick="addToCart(<%= Number(product.id) %>)" aria-label="Add <%= product.name %> to cart" class="w-full py-3 bg-[#0E1726] text-white rounded-xl text-sm font-bold hover:bg-[#16213E] active:scale-95 transition flex items-center justify-center gap-2 shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              <span>Add to Cart</span>
              </button>
              <% if (whatsappNumber) { %>
                <a href="https://wa.me/<%= whatsappNumber %>?text=<%= encodeURIComponent('Habari Giftopia! Ningependa kuuliza kuhusu ' + product.name + ' (' + Number(product.price_tzs).toLocaleString() + ' TZS).') %>" target="_blank" rel="noopener noreferrer" class="block w-full py-2 text-center text-sm font-semibold text-emerald-800 hover:text-emerald-900">
                  Ask about this gift on WhatsApp
                </a>
              <% } %>
            </div>
          </div>
        </article>
      <% }); %>
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="<%= products.length ? 'hidden' : '' %> text-center py-16 bg-white rounded-2xl border border-gray-200 p-8 my-6">
      <div class="w-16 h-16 bg-[#FBF6EC] text-[#C5A059] rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h3 class="font-display text-xl font-bold text-gray-900">No gifts found</h3>
      <p class="text-sm text-gray-500 mt-1 max-w-sm mx-auto">Try adjusting your search terms or clearing tier filters.</p>
      <button onclick="clearAllFilters()" class="mt-4 px-4 py-2 bg-[#C5A059] text-white rounded-lg text-sm font-medium hover:bg-[#0E1726] transition">
        Reset Filters
      </button>
    </div>
  </main>

  <!-- About Section -->
  <section id="about" class="bg-white border-t border-gray-200 py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-[#C5A059]">Urithi Wetu &bull; Cultural Heritage</span>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-gray-900 mt-2 mb-4">Gifts that tell a Tanzania story</h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            Bring home the flavors and craft of Tanzania: Kakakuwe coffee from an Arusha cooperative, Zanzibar spices, handwoven Maasai shuka, and flowers for life's celebrations. Shop for someone here, remember your travels, or send a little Tanzania to loved ones.
          </p>
          <div class="grid grid-cols-2 gap-4">
            <div class="p-4 bg-[#FAF8F5] rounded-2xl border border-[#E8E5DF]">
              <h4 class="font-bold text-gray-900">Budget Tier (30K)</h4>
              <p class="text-xs text-gray-500 mt-1">For everyday birthdays, thank-yous, and small gestures worth sharing.</p>
            </div>
            <div class="p-4 bg-[#FAF8F5] rounded-2xl border border-[#E8E5DF]">
              <h4 class="font-bold text-gray-900">Premium Tier (180K)</h4>
              <p class="text-xs text-gray-500 mt-1">For big celebrations and memorable keepsakes, from Maasai shuka to curated gift sets.</p>
            </div>
          </div>
        </div>
        <div class="relative">
          <img src="/assets/images/birthday-hamper.jpg" alt="A carefully wrapped gift" class="rounded-2xl shadow-xl w-full object-cover max-h-96" loading="lazy" decoding="async">
          <div class="absolute -bottom-4 -right-4 bg-gray-900 text-white p-4 rounded-xl shadow-lg hidden sm:block">
            <p class="text-xs uppercase tracking-wider text-[#C5A059] font-bold">Thoughtfully curated</p>
            <p class="text-sm font-semibold">For home, travels & loved ones</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="tanzanite-bg text-gray-400 py-12 px-4">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div>
        <h4 class="font-display text-2xl font-bold text-white mb-3">Giftopia</h4>
        <p class="text-xs leading-relaxed">
          Gifts for Tanzanian celebrations, visitors taking home a keepsake, and loved ones sending something special to Tanzania. <em class="font-display italic text-[#C5A059] block mt-2 not-italic">"Zawadi Zenye Thamani, Kumbukumbu za Milele"</em>
        </p>
      </div>
      <div>
        <h5 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Collections</h5>
        <ul class="space-y-2 text-xs">
          <li><a href="javascript:setTierFilter('budget')" class="hover:text-white transition">Budget Hampers (~30,000 TZS)</a></li>
          <li><a href="javascript:setTierFilter('premium')" class="hover:text-white transition">Premium Keepsakes (~180,000 TZS)</a></li>
          <li><a href="javascript:setTierFilter('all')" class="hover:text-white transition">Fresh Flower Bouquets</a></li>
          <li><a href="javascript:setTierFilter('all')" class="hover:text-white transition">Arusha Coffee & Zanzibar Spices</a></li>
        </ul>
      </div>
      <div>
        <h5 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Account & Payments</h5>
        <ul class="space-y-2 text-xs">
          <li><a href="javascript:openAuthModal('login')" class="hover:text-white transition">Sign In / Register</a></li>
          <li><a href="javascript:openAccountDrawer()" class="hover:text-white transition">Saved Payment Preferences</a></li>
          <li>Delivery options vary by destination</li>
          <li>Payment is confirmed after an order request</li>
        </ul>
      </div>
      <div>
        <h5 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Store Administration</h5>
        <p class="text-xs mb-3">Protected portal to manage products, offers, campaigns and database.</p>
        <a href="/admin" class="inline-block px-4 py-2 bg-[#C5A059] text-[#0E1726] rounded-xl text-xs font-bold hover:bg-[#A88237] hover:text-white transition shadow-sm">
          Admin Portal &rarr;
        </a>
      </div>
    </div>
    <div class="max-w-7xl mx-auto pt-8 border-t border-white/10 text-center text-xs">
      &copy; 2026 Giftopia Studio Ltd &mdash; Dar es Salaam, Tanzania. All rights reserved.
    </div>
  </footer>

  <% if (whatsappNumber) { %>
    <a href="https://wa.me/<%= whatsappNumber %>?text=<%= encodeURIComponent('Habari Giftopia! Ningependa msaada kuchagua zawadi.') %>" target="_blank" rel="noopener noreferrer" class="fixed bottom-4 right-4 z-30 flex h-12 w-12 items-center justify-center rounded-full bg-emerald-700 text-sm font-bold text-white shadow-lg md:hidden" aria-label="Ask Giftopia for gift advice on WhatsApp">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h8m-8 4h5m8-2a9 9 0 01-13.2 7.96L3 21l1.04-4.8A9 9 0 1121 12Z"/></svg>
    </a>
  <% } %>

  <!-- AUTH MODAL: SIGN IN & REGISTER -->
  <div id="authModal" class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full shadow-2xl overflow-hidden border border-gray-200">

      <!-- Auth Modal Tabs -->
      <div class="flex border-b border-gray-100 bg-gray-50/50">
        <button onclick="setAuthModalMode('login')" id="authTabLogin" class="flex-1 py-3.5 text-xs font-bold text-center border-b-2 border-[#C5A059] text-[#0E1726] transition">
          Sign In
        </button>
        <button onclick="setAuthModalMode('register')" id="authTabRegister" class="flex-1 py-3.5 text-xs font-bold text-center border-b-2 border-transparent text-gray-500 hover:text-gray-900 transition">
          Create Account
        </button>
      </div>

      <div class="p-6">
        <div id="authAlert" class="hidden mb-4 p-3 rounded-xl bg-rose-50 text-rose-700 text-xs font-medium border border-rose-200"></div>

        <!-- LOGIN FORM -->
        <form id="loginForm" onsubmit="handleUserLogin(event)" class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Email Address</label>
            <input type="email" id="loginEmail" required class="w-full px-3.5 py-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-[#C5A059] focus:outline-none" placeholder="you@example.com">
          </div>
          <div>
