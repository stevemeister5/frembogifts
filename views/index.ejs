<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FremboGifts - Dynamic Gift Delivery</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#faf8f5;--fg:#2d2a25;--muted:#6b6a66;--accent:#d59697;--accent-dark:#b87577;--card:#ffffff}.font-display{font-family:"Playfair Display",serif}.navbar{background:white;box-shadow:0 1px 3px 0 rgba(0,0,0,0.1)}.nav-link{color:var(--fg);text-decoration:none;font-weight:500;transition:color 0.2s}.nav-link:hover{color:var(--accent)}.hero{background:linear-gradient(135deg,#fffbf0 0%,#faf8f5 100%);padding:6rem 2rem 4rem}.hero-badge{background:var(--accent);color:white;padding:0.4rem 0.8rem;border-radius:20px;font-size:0.7rem;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:1rem}.hero-title{font-size:3.5rem;font-weight:700;line-height:1.1;margin-bottom:1rem}.hero-description{font-size:1.2rem;color:var(--muted);line-height:1.8;max-width:600px;margin-bottom:2rem}.categories{background:white;padding:2rem;margin-top:-4rem;margin-bottom:2rem;box-shadow:0 10px 25px rgba(0,0,0,0.05)}.category-tag{padding:0.6rem 1.2rem;border:1px solid #e2e2e2;border-radius:20px;font-size:0.85rem;text-decoration:none;color:var(--muted);margin-right:0.5rem;margin-bottom:0.5rem;display:inline-block;transition:all 0.2s}.category-tag:hover,.category-tag.active{background:var(--accent);color:white;border-color:var(--accent)}.product-card{background:var(--card);border-radius:12px;overflow:hidden;transition:transform 0.2s,box-shadow 0.2s;height:100%}.product-card:hover{transform:translateY(-4px);box-shadow:0 20px 40px rgba(0,0,0,0.1)}.product-image{width:100%;height:250px;object-fit:cover;background:#f5f0eb}.product-info{padding:1.5rem}.product-title{font-size:1.1rem;font-weight:600;margin-bottom:0.5rem;height:3.5em;overflow:hidden}.product-price{color:var(--accent);font-weight:600;font-size:1.2rem;margin-bottom:1rem}.product-options{display:flex;gap:0.5rem;margin-top:1rem}.option-btn{flex:1;padding:0.5rem;border:1px solid #e2e2e2;border-radius:6x;font-size:0.75rem;text-align:center;cursor:pointer;transition:background 0.2s}.option-btn:hover{background:#f5f0eb}.option-btn.active{background:var(--accent);color:white;border-color:var(--accent)}.budget-tag{padding:0.4rem 0.8rem;border:1px solid #e2e2e2;border-radius:20px;font-size:0.75rem;color:var(--muted);margin-right:0.3rem;margin-bottom:0.3rem;display:inline-block;cursor:pointer;transition:all 0.2s}.budget-tag.active{background:var(--accent);color:white;border-color:var(--accent)}.premium-tag{padding:0.4rem 0.8rem;border:1px solid #e2e2e2;border-radius:20px;font-size:0.75rem;color:var(--muted);margin-right:0.3rem;margin-bottom:0.3rem;display:inline-block;cursor:pointer;transition:all 0.2s}.premium-tag.active{background:var(--accent);color:white;border-color:var(--accent)}.filter-chip{padding:0.5rem 1rem;border:1px solid #e2e2e2;border-radius:20px;font-size:0.8rem;color:var(--muted);text-decoration:none;margin-right:0.5rem;margin-bottom:0.5rem;display:inline-block;transition:all 0.2s}.filter-chip:hover,.filter-chip.active{background:var(--accent);color:white;border-color:var(--accent)}.price-range{width:100%;height:4px;background:#e2e2e2;border-radius:2;margin:1rem 0}.price-range input{width:50%;height:100%;background:var(--accent);border:none;border-radius:2;cursor:pointer}.badge{display:inline-block;padding:0.2rem 0.6rem;background:#ffe8e9;color:var(--accent);font-size:0.7rem;border-radius:4px;margin-left:0.4rem}.offer-badge{background:var(--accent);color:white;padding:0.2rem 0.6rem;border-radius:4px;font-size:0.65rem;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:1rem;display:inline-block}.campaign-badge{background:#6b7c86;color:white;padding:0.2rem 0.6rem;border-radius:4px;font-size:0.65rem;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:1rem;display:inline-block}@media(max-width:640px){.hero-title{font-size:2.5rem}.hero-description{font-size:1rem}.product-info{padding:1rem}}</style>
</head>
<body>
  <nav class="navbar fixed top w-full z-50"><div class="max-w-7xl mx-auto px-4 flex items-center justify-between h-16"><a href="/#" class="font-display text-2xl font-bold tracking-tighter" style="color:var(--accent);">FremboGifts</a><div class="hidden md:flex items-center gap-8"><a href="/#budget" class="nav-link">Budget</a><a href="/#premium" class="nav-link">Premium</a><a href="/#about" class="nav-link">About</a></div><div class="relative"><a href="/cart" class="nav-link relative"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1l4 4m5 14l4-4M6 8l12-4l-2-8l-10 8"></path></svg><span class="cart-badge" id="cartCount">0</span></a></div></div></nav><button class="md:hidden p-2" id="menuBtn"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg></button><div class="mobile-menu" id="mobileMenu"><a href="/#budget" class="font-display text-2xl font-bold mb-6">FremboGifts</a><a href="/#budget" class="nav-link mb-3">Budget</a><a href="/#premium" class="nav-link mb-3">Premium</a><a href="/#about" class="nav-link mb-3">About</a><div class="mt-8"><a href="/#" class="relative"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"></svg><span class="hidden">Cart</span></a></div></div><section class="hero"><span class="hero-badge">Same-day delivery in Dar es Salaam & Arusha</span><h1 class="hero-title font-display">Taste of Tanzania</h1><p class="hero-description">Authentic local brands, Kakakuwe Coffee, Konyagi Gin & Maasai Shuka<br>Budget for average Tanzanian (30K TZS) | Premium for tourists/special occasions (180K TZS)</p><div class="grid grid-cols-2 gap-4 mt-6"><select id="tierSelect" class="border rounded p-2" style="border-color: #e2e2e2;"><option>Select tier</option><option>Budget (TSh 30K)</option><option>Premium (TSh 180K)</option></select></div><div class="mt-8"><div id="offersContainer"></div></div></section><section class="categories"><div class="grid grid-cols-2 gap-2 md:grid-cols-4" id="categoryTags"><a href="#" class="category-tag active" data-tier="budget">Budget</a><a href="#" class="category-tag" data-tier="premium">Premium</a><a href="#" class="category-tag" data-category="flowers">Flowers</a><a href="#" class="category-tag" data-category="hampers">Hampers</a><a href="#" class="category-tag" data-category="gifts">Gifts</a><a href="#" class="category-tag" data-category="accessories">Accessories</a></div></section><section id="budget" class="py-12 hidden"><div class="max-w-7xl mx-auto px-4"><h2 class="font-display text-3xl mb-8">Budget Collection (30,000 TZS)</h2><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="budgetProducts"></div></div></section><section id="premium" class="py-12 hidden"><div class="max-w-7xl mx-auto px-4"><h2 class="font-display text-3xl mb-8">Premium Collection (180,000 TZS)</h2><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="premiumProducts"></div></div></section><section id="about" class="py-12 bg-white"><div class="max-w-7xl mx-auto px-4"><h2 class="font-display text-3xl mb-6">About FremboGifts</h2><p class="text-lg text-muted mb-6">FremboGifts curates authentic Tanzania experiences in gift form, featuring local brands like Kakakuwe Coffee (Arusha), Konyagi Gin (national), and Maasai Shuka (cultural). We offer two clear price tiers: Budget (30,000 TZS / $12) for everyday gifting and Premium (180,000 TZS / $72) for special occasions and tourists.</p><div class="grid grid-cols-1 md:grid-cols-3 gap-6"><div><h3 class="font-semibold">Kakakuwe Coffee</h3><p>Arusha region coffee cooperative, 250g bag with recipe card</p></div><div><h3 class="font-semibold">Konyagi Gin</h3><p>Tanzania's local spirit, available in premium gift sets</p></div><div><h3 class="font-semibold">Maasai Shuka</h3><p>Full-size, 100% cotton cultural textile</p></div></div></div></section><footer class="bg-gray-800 text-white"><div class="max-w-7xl mx-auto px-4 py-12"><div class="grid grid-cols-1 md:grid-cols-3 gap-8"><div><h4 class="font-semibold mb-4" style="color: white;">FremboGifts</h4><p class="text-sm" style="color: #a8a7a5;">&copy; 2026 FremboGifts Ltd. All rights reserved.</p></div><div><h4 class="font-semibold mb-4" style="color: white;">Budget Tier</h4><a href="#" class="text-xs" style="color: #a8a7a5;">Budget Tier</a><a href="#" class="text-xs ml-4" style="color: #a8a7a5;">Premium Tier</a><a href="#" class="text-xs ml-4" style="color: #a8a7a5;">Local Brands</a><a href="#" class="text-xs ml-4" style="color: #a8a7a5;">Dual-Market</a></div><div><h4 class="font-semibold mb-4" style="color: white;">Info</h4><a href="#" class="text-xs" style="color: #a8a7a5;">How it Works</a><a href="#" class="text-xs ml-4" style="color: #a8a7a5;">Delivery & Fees</a><a href="#" class="text-xs ml-4" style="color: #a8a7a5;">Terms & Conditions</a></div></div><div class="mt-6 text-center text-sm" style="color: #a8a7a5;"><a href="#" class="mr-4" style="color: #a8a7a5;">Budget Tier</a><a href="#" class="mr-4" style="color: #a8a7a5;">Premium Tier</a><a href="#" class="mr-4" style="color: #a8a7a5;">Local Brands</a><a href="#" class="ml-4" style="color: #a8a7a5;">Dual-Market</a></div></div></footer><script>let currentTier='budget';function renderProducts(tier){fetch('/api/products?tier='+tier).then(r=>r.json()).then(products=>{const budgetProductsEl=document.getElementById('budgetProducts');const premiumProductsEl=document.getElementById('premiumProducts');if(tier==='budget'){budgetProductsEl.classList.remove('hidden');premiumProductsEl.classList.add('hidden');}else{budgetProductsEl.classList.add('hidden');premiumProductsEl.classList.remove('hidden');}budgetProductsEl.innerHTML='';premiumProductsEl.innerHTML='';products.forEach(product=>{const pc=document.createElement('div');pc.className='product-card';pc.innerHTML='<div class="product-image" style="background:#f5f0eb"></div><div class="product-info"><h3 class="product-title">'+product.name+'</h3><p class="product-price">'+product.price_tzs+' TZS / '+product.price_usd+' USD</p><p class="text-sm text-muted mt-2">'+product.description+'</p><div class="product-options"><button class="option-btn" data-tier="'+product.tier+'" onclick="filterByTier('+'''+product.tier+'''+')'>Select</button></div></div>';if(tier==='budget'){budgetProductsEl.appendChild(pc);}else{premiumProductsEl.appendChild(pc);}}));}function filterByTier(tier){currentTier=tier;renderProducts(tier);document.querySelectorAll('.budget-tag').forEach(tag=>tag.classList.toggle('active',tag.getAttribute('data-tier')===tier));document.querySelectorAll('.premium-tag').forEach(tag=>tag.classList.toggle('active',tag.getAttribute('data-tier')===tier));}document.querySelectorAll('.category-tag').forEach(tag=>{tag.addEventListener('click',()=>{document.querySelectorAll('.category-tag').forEach(t=>t.classList.remove('active'));tag.classList.add('active');});});const budgetTier=document.querySelectorAll('.budget-tier');const premiumTier=document.querySelectorAll('.premium-tier');const budgetProducts=document.querySelectorAll('.budget-products');const premiumProducts=document.querySelectorAll('.premium-products');budgetTier.forEach(tag=>{tag.addEventListener('click',()=>{budgetTier.forEach(t=>t.classList.remove('active'));tag.classList.add('active');budgetProducts.forEach(p=>p.style.display='block');premiumProducts.forEach(p=>p.style.display='none');});});premiumTier.forEach(tag=>{tag.addEventListener('click',()=>{premiumTier.forEach(t=>t.classList.remove('active'));tag.classList.add('active');premiumProducts.forEach(p=>p.style.display='block');budgetProducts.forEach(p=>p.style.display='none');});});budgetProducts.forEach(p=>p.style.display='block');premiumProducts.forEach(p=>p.style.display='none');const cartLinks=document.querySelectorAll('.navbar a[href="cart"]');let cartCount=0;cartLinks.forEach(link=>{const badge=link.querySelector('.cart-badge');if(badge){badge.textContent=cartCount;}});const tierSelect=document.getElementById('tierSelect');tierSelect.addEventListener('change',(e)=>{const selectedTier=e.target.value;if(selectedTier==='budget'){filterByTier('budget');}else if(selectedTier==='premium'){filterByTier('premium');}});renderProducts('budget');</script>
</body>
</html>