  <script id="storefrontData" type="application/json"><%- JSON.stringify({ products, offers, campaigns, whatsappNumber }).replace(/</g, '\\u003c') %></script>

  <!-- Application Logic -->
  <script>
    // State
    let currentUser = null;
    const storefrontData = JSON.parse(document.getElementById('storefrontData').textContent);
    let rawProducts = storefrontData.products;
    let activeOffers = storefrontData.offers;
    const whatsappNumber = storefrontData.whatsappNumber;
    let currentTier = 'all';
    let currentOccasion = 'all';
    let searchQuery = '';
    let currentSort = 'featured';
    let cart = [];

    // Toast Notification helper
    function showToast(message, type = 'success') {
      const container = document.getElementById('storeToastContainer');
      const toast = document.createElement('div');
      const bgColor = type === 'success' ? 'bg-gray-900 text-white' : 'bg-rose-600 text-white';
      toast.className = `${bgColor} px-4 py-3 rounded-xl shadow-lg text-sm flex items-center justify-between gap-3 transform transition-all duration-300 opacity-0 translate-y-2`;
      toast.innerHTML = `
        <span>${message}</span>
        <button onclick="this.parentElement.remove()" class="text-white/70 hover:text-white">&times;</button>
      `;
      container.appendChild(toast);
      requestAnimationFrame(() => {
        toast.classList.remove('opacity-0', 'translate-y-2');
      });
      setTimeout(() => {
        toast.classList.add('opacity-0');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    // Authenticated fetch wrapper
    async function authFetch(url, options = {}) {
      const token = localStorage.getItem('frembo_token');
      const headers = {
        'Content-Type': 'application/json',
        ...(options.headers || {})
      };
      if (token) {
        headers['Authorization'] = `Bearer ${token}`;
      }
      return fetch(url, { ...options, headers });
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', async () => {
      loadCartFromStorage();
      renderGrid();
      await checkUserAuth();
    });

    // Check Auth State on Load
    async function checkUserAuth() {
      const token = localStorage.getItem('frembo_token');
      if (!token) {
        renderAuthUI(null);
        return;
      }
      try {
        const res = await authFetch('/api/auth/me');
        const data = await res.json();
        if (data.success && data.user) {
          currentUser = data.user;
          renderAuthUI(currentUser);
          // Sync saved cart from database
          await syncCartWithServer();
        } else {
          localStorage.removeItem('frembo_token');
          renderAuthUI(null);
        }
      } catch (e) {
        renderAuthUI(null);
      }
    }

    // Render Auth UI in Navbar
    function renderAuthUI(user) {
      const container = document.getElementById('authNavContainer');
      const navAdminLink = document.getElementById('navAdminLink');
      const mobileAccountLink = document.getElementById('mobileAccountLink');

      if (user) {
        container.innerHTML = `
          <button onclick="openAccountDrawer()" class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-gray-200 text-xs font-semibold text-gray-800 hover:border-[#C5A059] transition bg-gray-50">
            <span class="w-5 h-5 rounded-full bg-[#C5A059] text-white flex items-center justify-center text-[10px]">
              ${user.name ? user.name[0].toUpperCase() : 'U'}
            </span>
            <span class="max-w-[100px] truncate">${escapeHtml(user.name.split(' ')[0])}</span>
          </button>
        `;
        if (mobileAccountLink) mobileAccountLink.classList.remove('hidden');
        if (user.role === 'admin' && navAdminLink) {
          navAdminLink.classList.remove('hidden');
        }
      } else {
        container.innerHTML = `
          <button onclick="openAuthModal('login')" class="whitespace-nowrap text-xs font-semibold px-3 py-1.5 rounded-full border border-gray-300 text-gray-700 hover:bg-gray-50 transition">
            Sign In
          </button>
        `;
        if (navAdminLink) navAdminLink.classList.add('hidden');
        if (mobileAccountLink) mobileAccountLink.classList.add('hidden');
      }
    }

    // AUTH MODAL LOGIC
    function openAuthModal(mode = 'login') {
      setAuthModalMode(mode);
      document.getElementById('authModal').classList.remove('hidden');
      document.getElementById('authAlert').classList.add('hidden');
    }

    function closeAuthModal() {
      document.getElementById('authModal').classList.add('hidden');
    }

    function setAuthModalMode(mode) {
      const loginTab = document.getElementById('authTabLogin');
      const regTab = document.getElementById('authTabRegister');
      const loginForm = document.getElementById('loginForm');
      const regForm = document.getElementById('registerForm');

      if (mode === 'login') {
        loginTab.className = 'flex-1 py-3.5 text-xs font-bold text-center border-b-2 border-[#C5A059] text-[#0E1726] transition';
        regTab.className = 'flex-1 py-3.5 text-xs font-bold text-center border-b-2 border-transparent text-gray-500 hover:text-gray-900 transition';
        loginForm.classList.remove('hidden');
        regForm.classList.add('hidden');
      } else {
        loginTab.className = 'flex-1 py-3.5 text-xs font-bold text-center border-b-2 border-transparent text-gray-500 hover:text-gray-900 transition';
        regTab.className = 'flex-1 py-3.5 text-xs font-bold text-center border-b-2 border-[#C5A059] text-[#0E1726] transition';
        loginForm.classList.add('hidden');
        regForm.classList.remove('hidden');
      }
    }

    function toggleRegPaymentFields(type) {
      const mpesa = document.getElementById('regMpesaField');
      const card = document.getElementById('regCardField');
      if (type === 'mpesa') {
        mpesa.classList.remove('hidden');
        card.classList.add('hidden');
      } else {
        mpesa.classList.add('hidden');
        card.classList.remove('hidden');
      }
    }

    // Handle User Login
    async function handleUserLogin(e) {
      e.preventDefault();
      const email = document.getElementById('loginEmail').value.trim();
      const password = document.getElementById('loginPassword').value;
      const btn = document.getElementById('loginSubmitBtn');
      const alert = document.getElementById('authAlert');

      btn.disabled = true;
      btn.textContent = 'Signing in...';
      alert.classList.add('hidden');

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        const data = await res.json();
        if (data.success && data.user) {
          localStorage.setItem('frembo_token', data.token);
          currentUser = data.user;
          renderAuthUI(currentUser);
          closeAuthModal();
          showToast(`Welcome back, ${currentUser.name}!`);
          await syncCartWithServer();
        } else {
          alert.textContent = data.message || 'Invalid credentials';
          alert.classList.remove('hidden');
        }
      } catch (err) {
        alert.textContent = 'Sign in failed: ' + err.message;
        alert.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Sign In to My Account';
      }
    }

    // Handle User Registration
    async function handleUserRegister(e) {
      e.preventDefault();
      const payload = {
        name: document.getElementById('regName').value.trim(),
        email: document.getElementById('regEmail').value.trim(),
        password: document.getElementById('regPassword').value,
        phone: document.getElementById('regPhone').value.trim(),
        city: document.getElementById('regCity').value,
        payment_method: document.querySelector('input[name="regPaymentMethod"]:checked').value,
        mpesa_number: document.getElementById('regMpesaNumber').value.trim(),
        card_last4: document.getElementById('regCardLast4').value.trim(),
        card_holder: document.getElementById('regCardHolder').value.trim(),
        card_exp: document.getElementById('regCardExp').value.trim()
      };

      const btn = document.getElementById('regSubmitBtn');
      const alert = document.getElementById('authAlert');
      btn.disabled = true;
      btn.textContent = 'Creating account...';
      alert.classList.add('hidden');

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success && data.user) {
          localStorage.setItem('frembo_token', data.token);
          currentUser = data.user;
          renderAuthUI(currentUser);
          closeAuthModal();
          showToast('Account created with payment details saved!');
          await syncCartWithServer();
        } else {
          alert.textContent = data.message || 'Registration failed';
          alert.classList.remove('hidden');
        }
      } catch (err) {
        alert.textContent = 'Error: ' + err.message;
        alert.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Create Account & Save Details';
      }
    }

    function handleUserLogout() {
      localStorage.removeItem('frembo_token');
      currentUser = null;
      renderAuthUI(null);
      closeAccountDrawer();
      showToast('You have signed out.');
    }

    // USER ACCOUNT DRAWER & PAYMENT DETAILS
    function openAccountDrawer() {
      if (!currentUser) {
        openAuthModal('login');
        return;
      }
      document.getElementById('accDrawerName').textContent = currentUser.name;
      document.getElementById('accDrawerEmail').textContent = currentUser.email;

      // Fill saved payment details
      const methodSelect = document.getElementById('accPaymentMethod');
      methodSelect.value = currentUser.payment_method || 'mpesa';
      document.getElementById('accMpesaNumber').value = currentUser.mpesa_number || currentUser.phone || '';
      document.getElementById('accCardHolder').value = currentUser.card_holder || currentUser.name || '';
      document.getElementById('accCardLast4').value = currentUser.card_last4 || '';
      document.getElementById('accCardExp').value = currentUser.card_exp || '';

      toggleAccPaymentFields();
      fetchUserOrders();
      document.getElementById('accountDrawer').classList.remove('hidden');
    }

    function closeAccountDrawer() {
      document.getElementById('accountDrawer').classList.add('hidden');
    }

    function toggleAccPaymentFields() {
      const method = document.getElementById('accPaymentMethod').value;
      const mpesaGroup = document.getElementById('accMpesaGroup');
      const cardGroup = document.getElementById('accCardGroup');
      if (method === 'card') {
        mpesaGroup.classList.add('hidden');
        cardGroup.classList.remove('hidden');
      } else {
        mpesaGroup.classList.remove('hidden');
        cardGroup.classList.add('hidden');
